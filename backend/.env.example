# Copy to .env for local development. Never commit real values.
APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/homend?sslmode=disable
# 32 random bytes, base64. Required when APP_ENV=prod (use a KMS-wrapped data key there).
# FIELD_ENCRYPTION_KEY=
# "log" prints one-time codes to the log and is refused when APP_ENV=prod.
SMS_PROVIDER=log
# ALLOWED_ORIGINS=https://console.example.co.ke
# Daraja (M-Pesa). Leave unset in dev to use the in-memory fake.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_INITIATOR=
# MPESA_SECURITY_CREDENTIAL=
# MPESA_B2C_SHORTCODE=
# Shared secret for Daraja, USSD, SMS and WhatsApp webhooks, and an optional source allow-list.
# WEBHOOK_TOKEN=
# WEBHOOK_ALLOWED_CIDRS=
# Document storage (S3). Unset in dev to use the local directory.
# STORAGE_BUCKET=
# STORAGE_KMS_KEY_ID=
# Public base URL used in webhook registration and links.
# PUBLIC_BASE_URL=https://api.example.co.ke
