# Copy to terraform.tfvars (git-ignored) and fill in.
public_base_url = "https://api.example.co.ke"
certificate_arn = "arn:aws:acm:eu-central-1:111111111111:certificate/..."
allowed_origins = ["https://console.example.co.ke", "https://example.co.ke"]
sms_provider    = "africastalking"
mpesa_shortcode = "000000"
vapid_subject   = "mailto:ops@example.co.ke"
console_domain          = "console.example.co.ke"
console_certificate_arn = "arn:aws:acm:us-east-1:111111111111:certificate/..."

# Optional: use a VPC you already have instead of creating one.
# existing_vpc_id             = "vpc-..."
# existing_public_subnet_ids  = ["subnet-...", "subnet-..."]
# existing_private_subnet_ids = ["subnet-...", "subnet-..."]

# Database backups in days. 1 fits an AWS Free plan account; use 30 on a paid plan.
# db_backup_retention_days = 30
